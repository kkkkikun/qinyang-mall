{
  "//": "后台页面级执行验证专用：把 admin-web 与 contracts 的 TS 编译成 CommonJS，供 Node 直接 require",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": ".harness-tmp",
    "rootDir": "../..",
    "types": [
      "node"
    ],
    "noEmitOnError": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/main.ts",
    "src/router/**"
  ]
}
