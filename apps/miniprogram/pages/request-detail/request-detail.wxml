<view class="page">
  <view class="nav" style="padding-top:{{nav.statusBarHeight}}px">
    <view class="nav__bar" style="height:{{nav.barHeight}}px">
      <view class="nav__back" bindtap="goBack">
        <image src="/assets/icons/back_ink.png" mode="aspectFit" />
      </view>
      <view class="nav__title" style="right:{{nav.capsuleGap}}px">申请详情</view>
      <view class="nav__right" style="width:{{nav.capsuleGap}}px"></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state">正在加载申请详情…</view>
  <view wx:elif="{{error}}" class="state">
    <view class="state__t">{{error}}</view>
    <view class="state__btn"><button class="btn btn--ghost btn--sm" bindtap="reload">重新加载</button></view>
  </view>

  <block wx:elif="{{dto}}">
    <!-- 状态 -->
    <view class="sec sec-pad" style="margin-top:8px">
      <view class="row row-b">
        <text class="serif rd-status">{{statusLabel}}</text>
        <text class="fs12 muted">{{dto.requestNo}}</text>
      </view>
      <view class="fs12 muted-2" style="margin-top:6px">提交时间：{{createdAtText}}</view>
      <view class="fs12 muted-2" style="margin-top:3px">量体模板：{{dto.templateName}} · v{{dto.templateVersion}}</view>
    </view>

    <!-- 商品 -->
    <view class="sec sec-pad">
      <view class="row gap10">
        <view class="rd-thumb">
          <image wx:if="{{dto.productCoverUrl && !imgErr}}" src="{{dto.productCoverUrl}}" mode="aspectFill" binderror="onImgErr" />
          <view wx:else class="img-fallback"><view class="img-fallback__mark"></view></view>
        </view>
        <view class="grow">
          <view class="fs13">QINYANG｜{{dto.productName}}</view>
          <view class="fs11 muted-2" style="margin-top:3px">{{dto.productCode}}</view>
        </view>
        <view class="rd-go" bindtap="goProduct">查看</view>
      </view>
    </view>

    <!-- 当前报价 -->
    <view class="sec sec-pad">
      <view class="row row-b" style="margin-bottom:8px">
        <text style="font-size:15px;font-weight:600">当前报价</text>
        <text class="fs12 muted" wx:if="{{dto.activeQuote}}">第 {{quoteVersion}} 版</text>
      </view>
      <block wx:if="{{dto.activeQuote}}">
        <view class="kv"><text class="kv__k">金额</text><text class="kv__v">{{quoteAmount}}</text></view>
        <view class="kv"><text class="kv__k">合计</text><text class="kv__v">{{quoteTotal}}</text></view>
        <view class="kv"><text class="kv__k">有效期</text><text class="kv__v">{{quoteValid}}</text></view>
        <view class="kv"><text class="kv__k">制作周期</text><text class="kv__v">{{dto.activeQuote.productionDays}} 天</text></view>
        <view class="kv" wx:if="{{dto.activeQuote.note}}">
          <text class="kv__k">说明</text><text class="kv__v">{{dto.activeQuote.note}}</text>
        </view>
        <button class="btn btn--tan btn--block" style="margin-top:12px" bindtap="goQuote">查看报价并确认</button>
      </block>
      <view wx:else class="fs13 muted-2">商家尚未报价，请耐心等待审核结果。</view>
    </view>

    <!-- 量体资料 -->
    <view class="sec" wx:for="{{sections}}" wx:key="key">
      <view class="sec-pad sec-pad--tight">
        <view class="row row-b">
          <text class="serif rd-title">{{item.title}}</text>
          <text class="tag {{item.typeLabel === '身体测量' ? '' : 'tag--gray'}}">{{item.typeLabel}}</text>
        </view>
      </view>
      <view class="rd-row" wx:for="{{item.rows}}" wx:key="name" wx:for-item="row">
        <view class="rd-row__k">
          <text>{{row.name}}</text>
          <text class="rd-row__t">{{row.typeLabel}}</text>
        </view>
        <text class="rd-row__v">{{row.value}} {{row.unit}}</text>
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="sec sec-pad">
      <view class="row row-b" style="margin-bottom:8px">
        <text style="font-size:15px;font-weight:600">联系方式</text>
      </view>
      <view class="kv"><text class="kv__k">称呼</text><text class="kv__v">{{dto.contact.name}}</text></view>
      <view class="kv"><text class="kv__k">电话</text><text class="kv__v">{{dto.contact.phone}}</text></view>
      <view class="kv"><text class="kv__k">地区</text><text class="kv__v">{{dto.contact.region}}</text></view>
      <view class="kv"><text class="kv__k">地址</text><text class="kv__v">{{dto.contact.detail}}</text></view>
    </view>

    <view class="sec sec-pad" wx:if="{{dto.remark}}">
      <view class="row row-b" style="margin-bottom:8px">
        <text style="font-size:15px;font-weight:600">留言</text>
      </view>
      <view class="fs13">{{dto.remark}}</view>
    </view>

    <!-- 关联订单 -->
    <view class="sec sec-pad" wx:if="{{dto.orderNo}}">
      <view class="kv"><text class="kv__k">关联订单</text><text class="kv__v">{{dto.orderNo}}</text></view>
    </view>

    <!-- 操作 -->
    <view class="sec sec-pad">
      <view class="row gap10">
        <button class="btn btn--ghost" style="flex:1" bindtap="goContact">联系客服</button>
        <button class="btn btn--ghost" style="flex:1" wx:if="{{canCancel}}" disabled="{{cancelling}}" bindtap="cancel">
          {{cancelling ? '处理中…' : '取消申请'}}
        </button>
      </view>
    </view>
    <view class="pd-bar-holder-sm"></view>
  </block>
</view>
