<view class="page">
  <view class="nav" style="padding-top:{{nav.statusBarHeight}}px">
    <view class="nav__bar" style="height:{{nav.barHeight}}px">
      <view class="nav__back" bindtap="goBack">
        <image src="/assets/icons/back_ink.png" mode="aspectFit" />
      </view>
      <view class="nav__title" style="right:{{nav.capsuleGap}}px">搜索</view>
      <view class="nav__right" style="width:{{nav.capsuleGap}}px"></view>
    </view>
  </view>

  <!-- 搜索条 -->
  <view class="searchbar">
    <view class="searchbox">
      <image src="/assets/icons/search_ink.png" mode="aspectFit" />
      <input class="searchbox__input" value="{{keyword}}" placeholder="搜索商品名称、颜色或编号"
        confirm-type="search" bindinput="onInput" bindconfirm="onConfirm" />
    </view>
    <view class="search-go" bindtap="onConfirm">搜索</view>
  </view>

  <!-- 热门搜索 / 店铺分类 -->
  <block wx:if="{{!searched}}">
    <view class="sec">
      <view class="mod-title"><text class="mod-title__t">热门搜索</text></view>
      <view class="mod-body">
        <view class="hot-list">
          <view class="hot-item" wx:for="{{hot}}" wx:key="*this" bindtap="onHotTap" data-word="{{item}}">{{item}}</view>
        </view>
      </view>
    </view>
    <view class="sec">
      <view class="mod-title"><text class="mod-title__t">按分类浏览</text></view>
      <view class="mod-body">
        <view class="hot-list">
          <view class="hot-item" wx:for="{{cats}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">{{item.name}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 搜索结果 -->
  <block wx:else>
    <view wx:if="{{loading}}" class="state">正在搜索…</view>
    <view wx:elif="{{error}}" class="state">
      <view class="state__t">{{error}}</view>
      <view class="state__btn"><button class="btn btn--ghost btn--sm" bindtap="onConfirm">重试</button></view>
    </view>
    <view wx:elif="{{!items.length}}" class="empty">
      <view class="empty__t">没有找到相关商品</view>
      <view class="empty__d">换个关键词试试，例如「开衫」「围巾」或商品编号</view>
      <view class="empty__act">
        <button class="btn btn--ghost btn--sm" bindtap="clearSearch">清空搜索</button>
        <button class="btn btn--tan btn--sm" bindtap="goCategory">去分类看看</button>
      </view>
      <view class="empty__hot">
        <view class="empty__hot-t">试试这些关键词</view>
        <view class="hot-list hot-list--center">
          <view class="hot-item" wx:for="{{hot}}" wx:key="*this" bindtap="onHotTap" data-word="{{item}}">{{item}}</view>
        </view>
      </view>
    </view>
    <view wx:else>
      <view class="sec">
        <view class="sec-pad fs12 muted">找到 {{items.length}} 件与「{{keyword}}」相关的商品</view>
        <view class="mod-body">
          <view class="pgrid">
            <view class="pgrid__cell" wx:for="{{items}}" wx:key="id" wx:for-index="idx" bindtap="goProduct" data-id="{{item.id}}">
              <view class="pcard pcard--square">
                <view class="pcard__ph">
                  <text class="pcard__wm">QINYANG</text>
                  <image wx:if="{{item.coverUrl && !imgErr[idx]}}" src="{{item.coverUrl}}" mode="aspectFill" binderror="onImgErr" data-index="{{idx}}" />
                  <view wx:else class="img-fallback"><view class="img-fallback__mark"></view></view>
                </view>
                <view class="pcard__body">
                  <view class="pcard__name clamp2">{{item.name}}</view>
                  <view class="pcard__foot">
                    <text class="{{item.priceCents !== null ? 'price' : 'price--tbd'}}">{{item.priceLabel}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
