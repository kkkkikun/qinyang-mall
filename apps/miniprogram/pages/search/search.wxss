/* 商品搜索页 */

.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 10px;
}

.hot-list--center {
  justify-content: center;
}

.hot-item {
  padding: 6px 12px;
  background: var(--field);
  border-radius: 14px;
  font-size: var(--fs-sm);
  color: var(--text-2);
}

.empty__hot {
  margin-top: 22px;
}

.empty__hot-t {
  font-size: var(--fs-sm);
  color: var(--text-3);
  margin-bottom: 10px;
}
