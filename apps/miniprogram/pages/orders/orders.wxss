/* 我的订单 */

.order-list {
  padding-top: 8px;
}

.order-card {
  background: var(--card);
  margin: 0 0 8px;
  padding: 13px 14px;
}

.order-card__hd text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 60%;
}

.order-card__hd {
  display: flex;
  justify-content: space-between;
  font-size: var(--fs-sm);
  color: var(--text-3);
  margin-bottom: 10px;
}

.order-card__st {
  color: var(--gold);
}

.order-card__body {
  display: flex;
  align-items: center;
  gap: 11px;
}

.order-card__thumb {
  flex: 0 0 62px;
  width: 62px;
  height: 62px;
  position: relative;
  overflow: hidden;
  background: var(--field);
  /* 缩略图统一圆角（原型 4px）：此前是直角，与其他卡片图不一致 */
  border-radius: 4px;
}

.order-card__thumb image {
  width: 100%;
  height: 100%;
}

.order-card__name {
  font-size: var(--fs-base);
  line-height: 1.5;
  color: var(--text);
  /* 真实商品名很长（如「QINYANG｜【沉金】复古驼棕格纹四色精纺双提纯羊绒小翻领女开衫高定款」），
     不截断会把卡片撑到三四行，列表节奏全乱 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-card__meta {
  font-size: var(--fs-xs);
  color: var(--text-3);
  margin-top: 3px;
}

.order-card__amt {
  font-size: var(--fs-lg);
  color: var(--text);
  font-weight: 600;
  margin-left: 8px;
}

.hint {
  text-align: center;
  font-size: var(--fs-xs);
  color: var(--text-3);
  padding: 10px 0 20px;
}
