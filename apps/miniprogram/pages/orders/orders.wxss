/* 我的订单 */

.order-list {
  padding-top: 8px;
}

.order-card {
  background: var(--card);
  margin: 0 0 8px;
  padding: 13px 14px;
}

.order-card__hd text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 60%;
}

.order-card__hd {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: var(--text-3);
  margin-bottom: 10px;
}

.order-card__st {
  color: var(--gold);
}

.order-card__body {
  display: flex;
  align-items: center;
  gap: 11px;
}

.order-card__thumb {
  flex: 0 0 62px;
  width: 62px;
  height: 62px;
  position: relative;
  overflow: hidden;
  background: var(--field);
}

.order-card__thumb image {
  width: 100%;
  height: 100%;
}

.order-card__name {
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--text);
}

.order-card__meta {
  font-size: 11.5px;
  color: var(--text-3);
  margin-top: 3px;
}

.order-card__amt {
  font-size: 15px;
  color: var(--text);
  font-weight: 600;
  margin-left: 8px;
}

.hint {
  text-align: center;
  font-size: 11.5px;
  color: var(--text-3);
  padding: 10px 0 20px;
}
