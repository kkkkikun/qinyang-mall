<view class="page">
  <!-- 自定义导航栏：右侧为真实胶囊预留空白 -->
  <view class="nav" style="padding-top:{{nav.statusBarHeight}}px">
    <view class="nav__bar" style="height:{{nav.barHeight}}px">
      <view class="nav__back"></view>
      <view class="nav__brand">琴扬精纺羊绒</view>
      <view class="nav__right" style="width:{{nav.capsuleGap}}px"></view>
    </view>
  </view>

  <!-- 品牌头 -->
  <view class="brand-head">
    <image class="brand-head__wm" src="/assets/brand/qinyang-word.png" mode="widthFix" />
    <view class="brand-head__cn">琴扬</view>
    <view class="brand-head__search" bindtap="goSearch">
      <image src="/assets/icons/search_ink.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 一级分类入口 -->
  <scroll-view class="cat-nav" scroll-x enable-flex>
    <view class="cat-nav__item" wx:for="{{cats}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">{{item.name}}</view>
  </scroll-view>

  <!-- 加载 / 错误 -->
  <view wx:if="{{loading}}" class="sk-grid">
    <view class="sk-card" wx:for="{{[0,1,2,3]}}" wx:key="*this">
      <view class="sk-thumb skeleton"></view>
      <view class="sk-line skeleton"></view>
      <view class="sk-line sk-line--short skeleton"></view>
    </view>
  </view>
  <view wx:elif="{{error}}" class="state">
    <view class="state__t">{{error}}</view>
    <view class="state__btn"><button class="btn btn--ghost btn--sm" bindtap="reload">重新加载</button></view>
  </view>

  <block wx:else>
    <!-- 主视觉 -->
    <view wx:if="{{hero}}" class="hero" bindtap="goProduct" data-id="{{hero.id}}">
      <view class="hero__ph" style="height:{{heroHeight}}px">
        <image wx:if="{{hero.coverUrl && !imgErr.hero}}" src="{{hero.coverUrl}}" mode="aspectFill" binderror="onImgErr" data-target="hero" data-index="0" />
        <view wx:else class="img-fallback"><view class="img-fallback__mark"></view><text>图片加载失败</text></view>
      </view>
      <view class="hero__ov">
        <view class="hero__t">{{hero.name}}</view>
        <view class="hero__s">{{hero.subtitleLine}} · 专属定制</view>
        <view class="hero__go">探索此款</view>
      </view>
    </view>

    <!-- 羊绒衣橱：自动轮播 + 手势滑动 -->
    <view class="sec">
      <view class="mod-title">
        <text class="mod-title__t">羊绒衣橱</text>
        <text class="mod-title__e">THE WARDROBE</text>
      </view>
      <view class="mod-body">
        <swiper wx:if="{{wardrobe.length}}" class="wardrobe" style="height:{{wardrobeHeight}}px"
          autoplay circular interval="4000" duration="500" indicator-dots
          indicator-color="rgba(255,255,255,0.45)" indicator-active-color="#D29B5E">
          <swiper-item wx:for="{{wardrobe}}" wx:key="id">
            <view class="wardrobe__item" bindtap="onWardrobeTap" data-linktype="{{item.linkType}}" data-linkvalue="{{item.linkValue}}">
              <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" />
              <view wx:if="{{item.title}}" class="wardrobe__cap">{{item.title}}</view>
            </view>
          </swiper-item>
        </swiper>
        <view wx:else class="wardrobe__empty">衣橱内容待上架</view>
      </view>
      <view class="mod-line"></view>
      <view class="mod-note mod-note--left">向左滑动，浏览衣橱</view>
    </view>

    <!-- 材质定制 -->
    <view class="dark-card" bindtap="goGuide" data-slug="guide-material">
      <view>
        <view class="dark-card__t">材质定制</view>
        <view class="dark-card__d">查看定制说明</view>
      </view>
      <view class="dark-card__arrow"><image src="/assets/icons/arrowlong_white.png" mode="aspectFit" /></view>
    </view>

    <!-- 量体定制 -->
    <view class="sec mt-8">
      <view class="mod-title"><text class="mod-title__t">量体定制</text></view>
      <view class="mod-body" style="padding-bottom:6px">
        <view class="fs13 muted-2">从一件合身的衣物开始。</view>
      </view>
      <view class="guide-2">
        <view class="guide-item" bindtap="goGuide" data-slug="guide-top">
          <view class="guide-item__ill"><image src="/assets/guide/top.png" mode="aspectFit" /></view>
          <view class="guide-item__t">上装</view>
          <view class="guide-item__go">查看量体说明</view>
        </view>
        <view class="guide-item" bindtap="goGuide" data-slug="guide-bottom">
          <view class="guide-item__ill"><image src="/assets/guide/bottom.png" mode="aspectFit" /></view>
          <view class="guide-item__t">长裤</view>
          <view class="guide-item__go">查看量体说明</view>
        </view>
      </view>
      <view class="mod-note mod-note--left">自然平铺，不拉伸。依商品页的量体图记录尺寸。</view>
      <view class="mod-line mod-line--hair"></view>
      <view class="mod-hint">订购前，与店铺客服核对尺寸及定制细节。</view>
    </view>

    <!-- 衣物养护 -->
    <view class="sec" style="margin-top:22px">
      <view class="mod-title"><text class="mod-title__t">衣物养护</text></view>
      <view class="list-row" bindtap="goGuide" data-slug="guide-care">
        <text>洗护指南</text>
        <view class="list-row__go"><image src="/assets/icons/right_gray.png" mode="aspectFit" /></view>
      </view>
      <view class="list-row" bindtap="goOrders">
        <text>我的订单</text>
        <view class="list-row__go"><image src="/assets/icons/right_gray.png" mode="aspectFit" /></view>
      </view>
    </view>

    <!-- 琴扬甄选 -->
    <view class="sec mt-8">
      <view class="mod-title">
        <text class="mod-title__t">琴扬甄选</text>
        <text class="mod-title__go" bindtap="goCategory">全部款式</text>
      </view>
      <scroll-view class="hscroll" scroll-x enable-flex>
        <view class="hscroll__card" wx:for="{{picks}}" wx:key="id" wx:for-index="idx" bindtap="goProduct" data-id="{{item.id}}">
          <view class="pcard pcard--square">
            <view class="pcard__ph">
              <text class="pcard__wm">QINYANG</text>
              <image wx:if="{{item.coverThumbUrl && !imgErr.pick[idx]}}" src="{{item.coverThumbUrl}}" mode="aspectFill" binderror="onImgErr" data-target="pick" data-index="{{idx}}" />
              <view wx:else class="img-fallback"><view class="img-fallback__mark"></view></view>
            </view>
            <view class="pcard__body pcard--bare">
              <view class="pcard__foot">
                <text class="{{item.priceCents !== null ? 'price' : 'price--tbd'}}">{{item.priceLabel}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="mod-note mod-note--dash">向左滑动，浏览全部款式</view>
    </view>

    <!-- 品牌故事 -->
    <view class="pd-story">
      <view class="pd-story__eyebrow">QINYANG</view>
      <view class="pd-story__h3">专属定制</view>
      <view class="pd-story__p">一件一码的定制体验。您提交的量体数据会随订单送达商家，<text class="pd-story__accent">按您的尺寸制作</text>。</view>
    </view>

    <!-- 更多商品 -->
    <view class="sec mt-8">
      <view class="mod-title"><text class="mod-title__t">更多商品</text></view>
      <view class="mod-body">
        <view class="pgrid">
          <view class="pgrid__cell" wx:for="{{more}}" wx:key="id" wx:for-index="idx" bindtap="goProduct" data-id="{{item.id}}">
            <view class="pcard pcard--square">
              <view class="pcard__ph">
                <text class="pcard__wm">QINYANG</text>
                <image wx:if="{{item.coverThumbUrl && !imgErr.more[idx]}}" src="{{item.coverThumbUrl}}" mode="aspectFill" binderror="onImgErr" data-target="more" data-index="{{idx}}" />
                <view wx:else class="img-fallback"><view class="img-fallback__mark"></view></view>
              </view>
              <view class="pcard__body">
                <view class="pcard__name clamp2">{{item.name}}</view>
                <view class="pcard__foot">
                  <text class="{{item.priceCents !== null ? 'price' : 'price--tbd'}}">{{item.priceLabel}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{!more.length}}" class="hint">暂无更多商品</view>
      </view>
    </view>

    <!-- 品牌带 -->
    <view class="footer-band">
      <image class="footer-band__wm" src="/assets/brand/qinyang-word.png" mode="widthFix" />
      <view class="footer-band__cn">琴 扬</view>
    </view>
    <view class="wx-footer">
      <view class="wx-footer__t">琴扬精纺羊绒</view>
      <view class="wx-footer__t2">— 微信小店提供技术支持 —</view>
    </view>
  </block>

  <button class="fab-share" open-type="share">
    <image src="/assets/icons/share_ink.png" mode="aspectFit" />
  </button>
</view>
