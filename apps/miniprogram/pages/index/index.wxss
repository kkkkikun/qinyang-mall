/* 品牌首页 */

.hero {
  position: relative;
  background: var(--card);
}

.hero__ph {
  width: 100%;
  position: relative;
  overflow: hidden;
  background: var(--field);
}

.hero__ph image {
  width: 100%;
  height: 100%;
}

.hero__ov {
  position: absolute;
  right: 30%;
  bottom: 11%;
  color: #fff;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  max-width: 62vw;
}

.hero__t {
  font-family: var(--serif);
  font-size: 28px;
  letter-spacing: 0.14em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero__s {
  font-size: 12.5px;
  letter-spacing: 0.14em;
  opacity: 0.94;
  margin-top: 4px;
}

.hero__go {
  display: inline-block;
  margin-top: 10px;
  font-size: 12px;
  letter-spacing: 0.1em;
  border-bottom: 1px solid rgba(255, 255, 255, 0.85);
  padding-bottom: 2px;
}

.wardrobe {
  width: 100%;
}

.wardrobe__item {
  width: 100%;
  height: 100%;
  position: relative;
  background: var(--field);
}

.wardrobe__item image {
  width: 100%;
  height: 100%;
}

.wardrobe__cap {
  position: absolute;
  left: 14px;
  bottom: 12px;
  font-family: var(--serif);
  font-size: 18px;
  letter-spacing: 0.1em;
  color: #fff;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
}

.wardrobe__empty {
  height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--field);
  color: var(--text-3);
  font-size: 13px;
}

.hscroll {
  display: flex;
  gap: 10px;
  padding: 10px 12px;
  background: var(--card);
  white-space: nowrap;
}

.hscroll__card {
  flex: 0 0 36%;
  display: inline-block;
}

.pcard--bare .pcard__body {
  padding-top: 8px;
}

.pd-story {
  background: var(--card);
  padding: 26px 18px;
  text-align: center;
}

.pd-story__eyebrow {
  font-size: 10px;
  letter-spacing: 0.3em;
  color: var(--text-3);
}

.pd-story__h3 {
  font-family: var(--serif);
  font-size: 22px;
  letter-spacing: 0.16em;
  margin: 8px 0 12px;
  color: var(--text);
}

.pd-story__p {
  font-size: 13.5px;
  line-height: 2;
  color: var(--text-2);
  text-align: left;
}

.pd-story__accent {
  color: var(--gold);
}

.mod-hint {
  font-size: 11px;
  color: var(--text-3);
  padding: 12px 22px 18px;
}

.hint {
  text-align: center;
  font-size: 11.5px;
  color: var(--text-3);
  padding: 10px 0 2px;
}
