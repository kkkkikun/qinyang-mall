<view class="page">
  <view class="nav" style="padding-top:{{nav.statusBarHeight}}px">
    <view class="nav__bar" style="height:{{nav.barHeight}}px">
      <view class="nav__back" bindtap="goBack">
        <image src="/assets/icons/back_ink.png" mode="aspectFit" />
      </view>
      <view class="nav__title" style="right:{{nav.capsuleGap}}px">订单详情</view>
      <view class="nav__right" style="width:{{nav.capsuleGap}}px"></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state">正在加载订单…</view>
  <view wx:elif="{{error}}" class="state">
    <view class="state__t">{{error}}</view>
    <view class="state__btn"><button class="btn btn--ghost btn--sm" bindtap="reload">重新加载</button></view>
  </view>

  <block wx:elif="{{order}}">
    <!-- 状态 -->
    <view class="sec sec-pad mt-8">
      <view class="row row-b">
        <text class="serif od-status">{{statusLabel}}</text>
        <text class="fs12 muted">{{order.orderNo}}</text>
      </view>
      <view class="fs12 muted-2 mt-6">下单时间：{{createdAtText}}</view>
      <view class="fs12 muted-2 mt-3">申请单号：{{order.requestNo}} · 报价第 {{order.quoteVersion}} 版</view>
    </view>

    <!-- 进度时间线 -->
    <view class="sec sec-pad">
      <view class="row row-b mb-12">
        <text class="sec-title">订单进度</text>
      </view>
      <view class="timeline" wx:if="{{events.length}}">
        <view class="timeline__item {{item.last ? 'timeline__item--last' : ''}}" wx:for="{{events}}" wx:key="key">
          <view class="timeline__dot"></view>
          <view class="timeline__body">
            <view class="timeline__title">{{item.title}}</view>
            <view class="timeline__time">{{item.time}}{{item.operator ? ' · ' + item.operator : ''}}</view>
            <view class="timeline__note" wx:if="{{item.note}}">{{item.note}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="fs13 muted-2">暂无进度记录</view>
    </view>

    <!-- 商品 -->
    <view class="sec sec-pad" wx:if="{{order.productSnapshot}}">
      <view class="row row-b mb-10">
        <text class="sec-title">商品</text>
        <text class="fs12 muted">{{order.productSnapshot.code}}</text>
      </view>
      <view class="row gap10">
        <view class="od-thumb">
          <image wx:if="{{order.productSnapshot.coverUrl && !imgErr}}" src="{{order.productSnapshot.coverUrl}}" mode="aspectFill" binderror="onImgErr" />
          <view wx:else class="img-fallback"><view class="img-fallback__mark"></view></view>
        </view>
        <view class="grow">
          <view class="fs13">{{order.productSnapshot.name}}</view>
          <view class="fs11 muted-2 mt-3">{{order.productSnapshot.categoryName}}</view>
        </view>
        <view class="rd-go" bindtap="goProduct">查看</view>
      </view>
    </view>

    <!-- 量体资料 -->
    <view class="sec" wx:if="{{measurements.length}}">
      <view class="sec-pad sec-pad--tight">
        <view class="row row-b">
          <text class="serif od-title">量体资料</text>
          <text class="fs12 muted" wx:if="{{order.measurementSnapshot}}">{{order.measurementSnapshot.templateName}}</text>
        </view>
      </view>
      <view class="rd-row" wx:for="{{measurements}}" wx:key="name">
        <text class="rd-row__k">{{item.name}}</text>
        <text class="rd-row__v">{{item.value}} {{item.unit}}</text>
      </view>
    </view>

    <!-- 金额 -->
    <view class="sec sec-pad">
      <view class="kv"><text class="kv__k">商品金额</text><text class="kv__v">{{amount}}</text></view>
      <view class="kv"><text class="kv__k">运费</text><text class="kv__v">{{freight}}</text></view>
      <view class="kv"><text class="kv__k">制作周期</text><text class="kv__v">{{order.productionDays}} 天</text></view>
      <view class="kv" style="border-top:1px solid var(--line);margin-top:6px;padding-top:12px">
        <text class="kv__k">合计</text><text class="kv__v" style="font-size:17px;font-weight:600">{{total}}</text>
      </view>
      <view class="notice notice--gold mt-12">
        V1 阶段不接入真实支付，线下结算方式以商家确认为准。
      </view>
    </view>

    <!-- 收货信息 -->
    <view class="sec sec-pad">
      <view class="row row-b mb-8">
        <text class="sec-title">收货信息</text>
      </view>
      <view class="kv"><text class="kv__k">称呼</text><text class="kv__v">{{order.contact.name}}</text></view>
      <view class="kv"><text class="kv__k">电话</text><text class="kv__v">{{order.contact.phone}}</text></view>
      <view class="kv"><text class="kv__k">地区</text><text class="kv__v">{{order.contact.region}}</text></view>
      <view class="kv"><text class="kv__k">地址</text><text class="kv__v">{{order.contact.detail}}</text></view>
    </view>

    <!-- 物流 -->
    <view class="sec sec-pad" wx:if="{{order.carrier || order.trackingNo}}">
      <view class="row row-b mb-8">
        <text class="sec-title">物流信息</text>
      </view>
      <view class="kv" wx:if="{{order.carrier}}"><text class="kv__k">承运</text><text class="kv__v">{{order.carrier}}</text></view>
      <view class="kv" wx:if="{{order.trackingNo}}"><text class="kv__k">单号</text><text class="kv__v">{{order.trackingNo}}</text></view>
      <view class="kv" wx:if="{{shippedAtText}}"><text class="kv__k">发货时间</text><text class="kv__v">{{shippedAtText}}</text></view>
    </view>

    <view class="sec sec-pad" wx:if="{{order.remark}}">
      <view class="row row-b mb-8">
        <text class="sec-title">留言</text>
      </view>
      <view class="fs13">{{order.remark}}</view>
    </view>

    <view class="sec sec-pad">
      <view class="row gap10">
        <button class="btn btn--ghost flex-1" bindtap="goRequest">查看定制申请</button>
        <button class="btn btn--ghost flex-1" bindtap="goContact">联系客服</button>
      </view>
    </view>
    <view class="pd-bar-holder-sm"></view>
  </block>
</view>
