/* 客服入口 */

.contact__ic {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #e9f1fd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42px;
}

.contact__ic image {
  width: 22px;
  height: 22px;
}

.mb8 {
  margin-bottom: 8px;
}

/* 静态说明行：没有跳转入口，不显示右侧箭头 */
.list-row--static {
  color: var(--text-2);
}
