/* 定制 Tab 页 */

.step {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 10px 0;
}

.step__no {
  flex: 0 0 22px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--gold);
  color: #fff;
  font-size: var(--fs-sm);
  text-align: center;
  line-height: 22px;
}

.step__t {
  font-size: var(--fs-md);
  color: var(--text);
}

.step__d {
  font-size: var(--fs-sm);
  color: var(--text-3);
  margin-top: 2px;
}

.custom-foot {
  padding: 16px 14px 8px;
}
