/* 我的定制申请 */

.req-list {
  padding-top: 8px;
}

.req-card {
  background: var(--card);
  margin: 0 0 8px;
  padding: 13px 14px;
}

.req-card__hd {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: var(--text-3);
  margin-bottom: 10px;
}

.req-card__st {
  color: var(--gold);
}

.req-card__body {
  display: flex;
  align-items: center;
  gap: 11px;
}

.req-card__thumb {
  flex: 0 0 62px;
  width: 62px;
  height: 62px;
  position: relative;
  overflow: hidden;
  background: var(--field);
  border-radius: 4px;
}

.req-card__thumb image {
  width: 100%;
  height: 100%;
}

.req-card__name {
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.req-card__meta {
  font-size: 11.5px;
  color: var(--text-3);
  margin-top: 3px;
}

.req-card__amt {
  font-size: 15px;
  color: var(--text);
  font-weight: 600;
  margin-left: 8px;
}

.hint {
  text-align: center;
  font-size: 11.5px;
  color: var(--text-3);
  padding: 10px 0 20px;
}
