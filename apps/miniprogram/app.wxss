/**
 * 全局样式（视觉基准：prototype/assets/css/app.css）。
 *
 * 颜色令牌：
 *   主色金 #D29B5E / 主要按钮麦金 #CD9150 / 次要按钮炭黑 #272727 /
 *   强调红 #F53939 / 页面底 #F2F2F2 / 卡片 #FFFFFF / 输入框 #F7F7F7
 */

page {
  --gold: #D29B5E;
  --gold-light: #E8C7A4;
  --tan: #CD9150;
  --ink: #272727;
  --ink-2: #3A3A3A;
  --red: #F53939;
  --bg: #F2F2F2;
  --card: #FFFFFF;
  --field: #F7F7F7;
  --line: #EBEBEB;
  --line-2: #E2E2E2;
  --band: #F3F4F1;
  --text: #1A1A1A;
  --text-2: #666666;
  --text-3: #999999;
  --serif: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", "SimSun", serif;
  --sans: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;

  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-size: 14px;
  line-height: 1.5;
}

view, text, image, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* ---------------- 自定义导航栏（真实胶囊占位） ---------------- */

.nav {
  position: sticky;
  top: 0;
  z-index: 60;
  background: var(--card);
  border-bottom: 1px solid var(--line);
}

.nav__bar {
  display: flex;
  align-items: center;
  padding: 0 12px;
  position: relative;
}

.nav__back {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.nav__back image {
  width: 20px;
  height: 20px;
}

.nav__title {
  position: absolute;
  left: 60px;
  right: 120px;
  text-align: center;
  font-size: 16px;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav__title--serif {
  font-family: var(--serif);
  letter-spacing: 0.08em;
}

.nav__right {
  flex: 0 0 auto;
  height: 1px;
}

.nav__brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-family: var(--serif);
  font-size: 16px;
  letter-spacing: 0.2em;
  text-indent: 0.2em;
  color: var(--ink);
  white-space: nowrap;
}

/* ---------------- 品牌头 ---------------- */

.brand-head {
  background: var(--card);
  padding: 16px 0 10px;
  text-align: center;
  position: relative;
}

.brand-head__wm {
  height: 26px;
  margin: 0 auto 6px;
}

.brand-head__cn {
  font-family: var(--serif);
  font-size: 17px;
  letter-spacing: 0.34em;
  text-indent: 0.34em;
  color: var(--text);
}

.brand-head__search {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-head__search image {
  width: 20px;
  height: 20px;
}

.cat-nav {
  display: flex;
  background: var(--card);
  border-bottom: 1px solid var(--line);
  overflow-x: auto;
}

.cat-nav__item {
  /* 等分满宽：原型与参考图都是 4 项均分居中，
     此前 flex:0 0 auto 让它们挤在左半屏、右侧大片空白 */
  flex: 1 0 auto;
  text-align: center;
  padding: 11px 0;
  font-size: 14px;
  color: var(--text);
}

/* ---------------- 通用块 ---------------- */

.sec {
  background: var(--card);
  margin-top: 8px;
}

.sec-pad {
  padding: 14px;
}

.sec-pad--tight {
  padding-bottom: 2px;
}

.mod-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16px 14px 6px;
}

.mod-title__t {
  font-family: var(--serif);
  font-size: 20px;
  letter-spacing: 0.1em;
  color: var(--text);
}

.mod-title__e {
  font-size: 10px;
  letter-spacing: 0.24em;
  color: var(--text-3);
}

.mod-title__go {
  font-size: 12px;
  color: var(--text-2);
  text-decoration: underline;
}

.mod-body {
  padding: 0 14px 14px;
}

.mod-line {
  height: 1px;
  background: var(--line);
  margin: 12px 14px;
}

.mod-line--hair {
  margin: 0 22px;
}

.mod-note {
  font-size: 11.5px;
  color: var(--text-3);
  text-align: center;
  padding: 6px 14px 0;
}

.mod-note--left {
  text-align: left;
  padding-left: 22px;
  padding-right: 22px;
}

.mod-note--dash {
  display: flex;
  align-items: center;
  gap: 14px;
  text-align: left;
  padding-left: 32px;
  padding-right: 22px;
}

.mod-note--dash::before {
  content: "";
  display: block;
  flex: 0 0 auto;
  width: 38px;
  height: 1px;
  background: var(--line-2);
}

.row {
  display: flex;
  align-items: center;
}

.row-b {
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.gap6 { gap: 6px; }
.gap8 { gap: 8px; }
.gap10 { gap: 10px; }
.gap12 { gap: 12px; }

.fs11 { font-size: 11px; }
.fs12 { font-size: 12px; }
.fs13 { font-size: 13px; }
.fs14 { font-size: 14px; }

.muted { color: var(--text-3); }
.muted-2 { color: var(--text-2); }
.serif { font-family: var(--serif); }
.center { text-align: center; }

.ellip {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ---------------- 按钮 ---------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 40px;
  padding: 0 16px;
  border-radius: 6px;
  font-size: 14px;
  line-height: 1;
  /* 交互反馈：此前全站零动效、零点击反馈，点任何东西视觉上都没反应 */
  transition: opacity .15s ease, transform .1s ease-out, background-color .15s ease;
}

.btn:active {
  transform: scale(.985);
  opacity: .92;
}

.btn--tan { background: var(--tan); color: #fff; }
.btn--ink { background: var(--ink); color: #fff; }
.btn--gold { background: var(--gold); color: #fff; }
.btn--ghost { background: var(--card); color: var(--ink); border: 1px solid var(--line-2); }
.btn--block { width: 100%; }
.btn--sm { height: 30px; padding: 0 12px; font-size: 12.5px; border-radius: 5px; }
.btn--link {
  background: none;
  padding: 0;
  height: auto;
  font-size: 13px;
  color: var(--text-2);
  text-decoration: underline;
}

.btn--disabled {
  opacity: 0.45;
  pointer-events: none;
}

.btn image {
  width: 16px;
  height: 16px;
}

/* ---------------- 标签 ---------------- */

.tag {
  display: inline-flex;
  align-items: center;
  height: 18px;
  padding: 0 5px;
  border: 1px solid var(--gold);
  color: var(--gold);
  border-radius: 3px;
  font-size: 10px;
  line-height: 1;
}

.tag--gray { border-color: var(--line-2); color: var(--text-3); }
.tag--red { border-color: var(--red); color: var(--red); }

/* ---------------- 顶部页签 ---------------- */

.tabs {
  display: flex;
  background: var(--card);
  border-bottom: 1px solid var(--line);
  padding: 0 6px;
  overflow-x: auto;
}

.tabs__item {
  flex: 0 0 auto;
  padding: 13px 14px 11px;
  font-size: 15px;
  color: var(--text);
  position: relative;
  white-space: nowrap;
}

.tabs__item--on {
  color: var(--gold);
  font-weight: 500;
}

.tabs__item--on::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 24px;
  height: 2px;
  background: var(--gold);
}

.tabs__item--red.tabs__item--on {
  color: var(--red);
}

.tabs__item--red.tabs__item--on::after {
  display: none;
}

/* ---------------- 搜索条 ---------------- */

.searchbar {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--card);
  padding: 10px 12px;
}

.searchbox {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  height: 34px;
  background: var(--field);
  border-radius: 5px;
  padding: 0 10px;
  color: var(--text-3);
  font-size: 13px;
}

.searchbox image {
  width: 17px;
  height: 17px;
  flex: 0 0 auto;
}

.searchbox__input {
  flex: 1;
  min-width: 0;
  height: 34px;
  font-size: 13px;
  color: var(--text);
}

.search-go {
  color: var(--gold);
  font-size: 15px;
  white-space: nowrap;
}

/* ---------------- 价格 ---------------- */

.price {
  font-size: 16px;
  color: var(--text);
  font-weight: 600;
}

.price__cur { font-size: 12px; margin-right: 1px; }
.price--red { color: var(--red); }
.price--tbd {
  font-size: 13px;
  color: var(--gold);
  font-weight: 500;
  letter-spacing: 0.06em;
}

/* ---------------- 商品卡 ---------------- */

.pgrid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.pgrid__cell {
  width: 48%;
  margin-bottom: 10px;
}

/* 可点元素的按压反馈 */
.pcard:active,
.list-row:active,
.req-card:active,
.order-card:active,
.tabs__item:active {
  opacity: .88;
}

.pcard {
  background: var(--card);
  overflow: hidden;
}

.pcard--square {
  border-radius: 0;
}

.pcard__ph {
  position: relative;
  background: var(--field);
  width: 100%;
  height: 0;
  padding-bottom: 133%;
  overflow: hidden;
}

.pcard__ph--tall {
  padding-bottom: 133%;
}

/* 分类页商品图比例 0.86（宽 / 高），即高度为宽度的 116% */
.pcard__ph--cat {
  padding-bottom: 116%;
}

.pcard__ph--hero {
  padding-bottom: 125%;
}

.pcard__ph image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.pcard__wm {
  position: absolute;
  left: 8px;
  top: 8px;
  font-size: 8px;
  letter-spacing: 0.18em;
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.82);
  padding: 2px 5px;
  border-radius: 2px;
  font-weight: 600;
  z-index: 2;
}

.pcard__body {
  padding: 8px 9px 10px;
}

.pcard__name {
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--text);
  min-height: 37px;
}

.pcard__ship {
  font-size: 11px;
  color: var(--text-3);
  margin-top: 6px;
}

.pcard__foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 4px;
}

/* 图片占位（加载失败兜底，避免破图） */
.img-fallback {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--field);
  color: var(--text-3);
  font-size: 11px;
  gap: 4px;
}

.img-fallback__mark {
  width: 22px;
  height: 16px;
  border: 1px solid var(--line-2);
  position: relative;
}

.img-fallback__mark::after {
  content: "";
  position: absolute;
  left: 3px;
  top: 3px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--line-2);
}

/* ---------------- 列表行 ---------------- */

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px;
  border-bottom: 1px solid var(--line);
  background: var(--card);
  font-size: 14px;
}

.list-row:last-child { border-bottom: none; }

.list-row__go {
  color: var(--text-3);
  display: flex;
  align-items: center;
}

.list-row__go image {
  width: 15px;
  height: 15px;
}

/* ---------------- 深色引导卡 ---------------- */

.dark-card {
  margin: 8px 22px 0;
  background: var(--ink);
  color: #fff;
  padding: 22px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.dark-card__t {
  font-family: var(--serif);
  font-size: 21px;
  letter-spacing: 0.14em;
}

.dark-card__d {
  font-size: 11.5px;
  color: rgba(255, 255, 255, 0.62);
  margin-top: 4px;
}

.dark-card__arrow {
  margin-left: auto;
  flex: 0 0 auto;
}

.dark-card__arrow image {
  width: 34px;
  height: 14px;
}

/* ---------------- 首页量体模块 ---------------- */

.guide-2 {
  display: flex;
  padding: 6px 0 14px 12px;
}

.guide-item {
  width: 50%;
  flex: 0 0 50%;
  text-align: center;
}

.guide-item__ill {
  height: 136px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
}

.guide-item__ill image {
  width: 132px;
  height: 132px;
}

.guide-item__t {
  font-family: var(--serif);
  font-size: 16px;
  letter-spacing: 0.1em;
}

.guide-item__go {
  font-size: 11px;
  color: var(--text-2);
  text-decoration: underline;
  margin-top: 6px;
  display: inline-block;
}

/* ---------------- 页脚 ---------------- */

.footer-band {
  background: var(--card);
  padding: 26px 0 30px;
  text-align: center;
}

.footer-band__wm {
  margin: 0 auto 8px;
  height: 22px;
}

.footer-band__cn {
  font-family: var(--serif);
  font-size: 15px;
  letter-spacing: 0.34em;
  text-indent: 0.34em;
  color: var(--text-2);
}

.wx-footer {
  background: var(--card);
  padding: 22px 0 26px;
  text-align: center;
}

.wx-footer__t {
  font-size: 11px;
  color: var(--text-2);
  letter-spacing: 0.08em;
}

.wx-footer__t2 {
  font-size: 11px;
  color: var(--text-3);
  margin-top: 7px;
}

/* ---------------- 状态区（加载 / 空 / 错误） ---------------- */

.state {
  padding: 60px 24px;
  text-align: center;
  color: var(--text-3);
  font-size: 13px;
}

.state__t {
  font-size: 14px;
  color: var(--text-2);
  margin-bottom: 6px;
}

.state__d {
  font-size: 12px;
  line-height: 1.7;
}

.state__btn {
  margin-top: 16px;
  display: inline-flex;
}

.empty {
  padding: 70px 24px;
  text-align: center;
  color: var(--text-3);
}

.empty__t {
  font-size: 14px;
  color: var(--text-2);
  margin-bottom: 6px;
}

.empty__d {
  font-size: 12px;
  line-height: 1.7;
}

.empty__act {
  margin-top: 16px;
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* ---------------- 提示条 ---------------- */

.notice {
  background: var(--field);
  color: var(--text-2);
  font-size: 12px;
  padding: 10px 14px;
  line-height: 1.7;
}

.notice--gold { background: #FBF3E9; color: #8A6A3A; }
.notice--red { background: #FDECEC; color: #C0392B; }

/* ---------------- 悬浮按钮 ---------------- */

.fab-share {
  position: fixed;
  right: 16px;
  bottom: 118px;
  z-index: 50;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--card);
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.13);
}

.fab-share image {
  width: 20px;
  height: 20px;
}

/* ---------------- 底部操作栏 ---------------- */

.pd-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 55;
  background: var(--card);
  border-top: 1px solid var(--line);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
}

.pd-bar__ico {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  font-size: 10.5px;
  color: var(--text-2);
  width: 44px;
  flex: 0 0 auto;
}

.pd-bar__ico image {
  width: 20px;
  height: 20px;
}

.pd-bar__ico--btn {
  border: none;
  background: none;
  padding: 0;
  line-height: 1.2;
}

.pd-bar .btn { flex: 1; }

/* ---------------- 键值行 ---------------- */

.kv {
  padding: 7px 0;
  font-size: 13px;
  display: flex;
  align-items: center;
}

.kv__k {
  color: var(--text-2);
  flex: 0 0 60px;
}

.kv__v {
  color: var(--text);
  flex: 1;
  min-width: 0;
}

/* ---------------- 服务标签 ---------------- */

.svc {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  padding: 4px 14px 12px;
  background: var(--card);
}

.svc__item {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  color: var(--text-2);
}

.svc__item image {
  width: 16px;
  height: 16px;
}
