# 琴扬商城 V1 · 环境变量模板
#
# 复制为 infra/docker/.env 后按实际填写；**.env 不得提交 Git**。
# 服务器上权限设为 600。

# ── MySQL ──────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
DB_DATABASE=qinyang_mall
DB_USERNAME=qinyang
DB_PASSWORD=change-me-app

# ── 令牌密钥（两类必须不同，建议 32 字节以上随机）────────
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_CUSTOMER_SECRET=change-me-customer-secret

# ── 存储 ───────────────────────────────────────────────
# local = 受控文件存储（开发/测试）；oss = 对象存储（需商家授权后实现）
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:18110/static
# 只读媒体根：商品目录图片所在目录（容器内通常只读挂载）；留空则不额外挂载
STORAGE_MEDIA_ROOT=/app/media

# ── 微信 ───────────────────────────────────────────────
# 开发/测试可置 true 使用 mock 顾客登录；正式环境必须 false 并配置 AppID/Secret
WECHAT_MOCK_AUTH=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── 支付 ───────────────────────────────────────────────
# V1 固定 false：真实微信支付需商家明确批准后单独实现
PAYMENT_ENABLED=false

# ── 其他 ───────────────────────────────────────────────
CORS_ORIGINS=http://127.0.0.1:18111
NODE_ENV=development
IMAGE_TAG=local

# ── 种子账号（仅开发/测试环境使用）─────────────────────
# 生产环境请在后台重置密码，不要沿用默认值
SEED_OWNER_USERNAME=owner
SEED_STAFF_USERNAME=staff
SEED_ADMIN_PASSWORD=change-me-admin-password
