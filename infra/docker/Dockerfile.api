# 琴扬商城 API 镜像
#
# 基础镜像使用国内镜像源（服务器直连 Docker Hub 受限）。
# 构建上下文为仓库根目录（见 infra/docker/docker-compose.test.yml）。
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/node:24-alpine

# pnpm 11（与 package.json 的 packageManager 一致）
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

WORKDIR /app

# 先装依赖，利用层缓存
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/api/package.json apps/api/
COPY apps/admin-web/package.json apps/admin-web/
COPY apps/miniprogram/package.json apps/miniprogram/ 2>/dev/null || true

RUN pnpm install --frozen-lockfile --filter @qinyang/contracts --filter @qinyang/api

COPY packages/ packages/
COPY apps/api/ apps/api/

RUN pnpm --filter @qinyang/contracts build \
 && pnpm --filter @qinyang/api build

# 只保留运行期依赖
RUN pnpm --filter @qinyang/api deploy --prod /app/deploy \
 && rm -rf /app/packages /app/apps/admin-web /root/.local/share/pnpm/store

ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app/deploy
EXPOSE 3000

# 容器资源与日志限制由 compose 统一约束
CMD ["node", "dist/main.js"]
