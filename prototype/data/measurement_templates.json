          ]
        },
        {
          "section_id": "garment_flat",
          "title": "合身衣物平铺测量",
          "measurement_type": "garment_flat",
          "description": "平铺一条穿着合身的裤装或裙装，量取腰围、臀围与长度。",
          "measurement_fields": [
            {
              "field_code": "waist_flat",
              "field_name": "腰围（平铺）",
              "measurement_type": "garment_flat",
              "unit": "cm",
              "required": false,
              "instruction": "衣物平铺后沿腰部边缘水平绕量一周，或量腰头平直宽度后 ×2。",
              "tips": ["不要拉伸腰头", "松紧腰标注弹性腰"],
              "illustration": "prototype/assets/img/measure/waist_flat.svg",
              "min": 50, "max": 130, "step": 0.5
            },
            {
              "field_code": "hip_flat",
              "field_name": "臀围（平铺）",
              "measurement_type": "garment_flat",
              "unit": "cm",
              "required": false,
              "instruction": "衣物平铺，量臀部最宽处横向水平距离 ×2。",
              "tips": ["平铺后不要抻拉"],
              "illustration": "prototype/assets/img/measure/hip_flat.svg",
              "min": 60, "max": 140, "step": 0.5
            },
            {
              "field_code": "length_flat",
              "field_name": "裤长 / 裙长",
              "measurement_type": "garment_flat",
              "unit": "cm",
              "required": true,
              "instruction": "衣物自然平铺，从腰头上沿垂直量至下摆边缘。",
              "tips": ["腰头含不含按客户要求注明"],
              "illustration": "prototype/assets/img/measure/length.svg",
              "min": 40, "max": 120, "step": 0.5
            }
          ]
        }
      ]
    },
